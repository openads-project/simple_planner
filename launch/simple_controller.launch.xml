<launch>

  <node pkg="simple_planner" exec="simple_controller_node" name="simple_controller_node" output="screen">
    <remap from="~/ego_data_topic" to="/carla_its_adapter/ego_data"/>
    <remap from="~/trajectory_topic" to="/trajectory_supervision_node/output_topic"/>
